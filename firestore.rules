rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /clubs/{uid} {

      match /settings/main {
        allow read:  if true;
        allow write: if request.auth != null
                     && request.auth.uid == uid;
      }

      match /settings/billCounter {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /settings/canteenMenu {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /tables/{tableId} {
        allow read:  if true;
        allow write: if request.auth != null
                     && request.auth.uid == uid;
      }

      match /bills/{billId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /canteen/{itemId} {
        allow read:  if true;
        allow write: if request.auth != null
                     && request.auth.uid == uid;
      }

      match /{anything=**} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}